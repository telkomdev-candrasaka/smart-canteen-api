{
  "name": "smart-canteen-api",
  "version": "1.0.0",
  "description": "Backend API untuk sistem pemesanan multi-tenant open space dengan fitur single checkout, RBAC, dan notifikasi real-time (Redis + SSE)",
  "main": "src/server.js",
  "scripts": {
    "build": "node --check src/server.js && node --check src/app.js && node --check src/seed.js",
    "lint": "eslint .",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "test": "jest --runInBand --coverage"
  },
  "keywords": [
    "nodejs",
    "express",
    "crud",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.15.1",
    "pino": "^9.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "eslint": "^9.30.1",
    "globals": "^16.3.0",
    "jest": "^25.0.0",
    "mongodb-memory-server": "^11.1.0",
    "supertest": "^7.2.2"
  }
}